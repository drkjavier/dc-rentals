---
// src/components/layout/layout.astro — shell HTML base (SDD §5, §18 a11y)
import "@/styles/globals.css";
import Header from "./header.astro";
import Footer from "./footer.astro";
import { t, localeConfig, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const htmlLang = localeConfig[locale].htmlLang;
const hasHeadSlot = Astro.slots.has("head");
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {
      !hasHeadSlot && (
        <>
          <title>{title}</title>
          {description && <meta name="description" content={description} />}
        </>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="bg-neutral-50 font-sans text-neutral-800 antialiased">
    <a href="#main-content" class="skip-link">{t(locale, "nav.skip_to_content")}</a>
    <Header locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
