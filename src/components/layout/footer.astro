---
// src/components/layout/footer.astro — SDD §5.1 + LANDING-PAGE §6.1 (Footer)
import { t, localizedPath, type Locale } from "@/lib/i18n";
import { LOCATIONS } from "@/lib/locations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

const explore = [
  { href: localizedPath(locale, "/vehicles"), label: t(locale, "nav.vehicles") },
  { href: localizedPath(locale, "/routes"), label: t(locale, "nav.routes") },
  { href: `/${locale}/faq`, label: t(locale, "nav.faq") },
];
---

<footer class="border-t border-neutral-200 bg-neutral-900 text-neutral-300">
  <div class="container-page section-spacing grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-heading text-lg font-extrabold text-white">DC Rentals</p>
      <p class="mt-3 text-sm leading-relaxed text-neutral-400">{t(locale, "footer.tagline")}</p>
    </div>

    <nav aria-label={t(locale, "footer.explore")}>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">
        {t(locale, "footer.explore")}
      </h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          explore.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">
        {t(locale, "footer.pickup_locations")}
      </h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          LOCATIONS.map((loc) => (
            <li>
              {loc.city},{" "}
              {locale === "fr" ? loc.provinceLabelFr : loc.provinceLabelEn}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">
        {t(locale, "footer.contact_title")}
      </h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href="tel:+18005550199" class="transition-colors hover:text-white">
            1-800-555-0199
          </a>
        </li>
        <li>
          <a href="mailto:hello@dc-rentals.ca" class="transition-colors hover:text-white">
            hello@dc-rentals.ca
          </a>
        </li>
        <li class="text-neutral-500">{t(locale, "footer.terms")}</li>
        <li class="text-neutral-500">{t(locale, "footer.privacy")}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-neutral-800 py-6">
    <p class="container-page text-xs text-neutral-500">
      © {year} DC Rentals. {t(locale, "footer.rights")}
    </p>
  </div>
</footer>
