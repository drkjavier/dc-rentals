---
// src/components/routes/route-detail-page.astro — Detalle de ruta (MDX)
import Layout from "@/components/layout/layout.astro";
import SeoHead from "@/components/shared/seo-head.astro";
import Button from "@/components/ui/button.astro";
import { t, localizedPath, type Locale } from "@/lib/i18n";
import { localizeSeo } from "@/lib/seo";
import type { RouteSummary } from "@/lib/content";

interface Props {
  route: RouteSummary;
  locale: Locale;
  // Componente MDX renderizado con entry.render() de astro:content
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  Content: any;
}

const { route, locale, Content } = Astro.props;

const { canonical, alternates } = localizeSeo(locale, Astro.url.pathname);
const title = `${route.name} | ${t(locale, "routes_page.title")} | DC Rentals`;
const description = route.description;
---

<Layout locale={locale} title={title} description={description}>
  <SeoHead
    slot="head"
    title={title}
    description={description}
    canonical={canonical}
    alternates={alternates}
    image={route.image}
    locale={locale}
  />

  <article class="container-page py-10">
    <p class="text-sm">
      <a
        href={localizedPath(locale, "/routes")}
        class="font-medium text-brand-primary hover:underline"
      >
        ← {t(locale, "routes_page.back_to_routes")}
      </a>
    </p>

    <img
      src={route.image}
      alt={route.name}
      width="1200"
      height="630"
      class="mt-4 aspect-[21/9] w-full rounded-xl object-cover"
    />

    <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_280px]">
      <div class="prose prose-neutral max-w-none">
        <Content />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-xl border border-neutral-200 bg-white p-6">
          <h2 class="font-heading text-lg font-bold text-neutral-900">
            {t(locale, "routes_page.highlights")}
          </h2>
          <ul class="mt-3 space-y-2 text-sm text-neutral-700">
            {route.highlights.map((highlight) => (
              <li class="flex gap-2">
                <span class="text-brand-secondary" aria-hidden="true">
                  ✓
                </span>
                {highlight}
              </li>
            ))}
          </ul>

          <h2 class="mt-6 font-heading text-lg font-bold text-neutral-900">
            {t(locale, "vehicle.specs_title")}
          </h2>
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between">
              <dt class="text-neutral-500">{t(locale, "routes_page.distance")}</dt>
              <dd class="font-medium">{route.distance}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-neutral-500">{t(locale, "routes_page.duration")}</dt>
              <dd class="font-medium">{route.duration}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-neutral-500">{t(locale, "routes_page.best_season")}</dt>
              <dd class="font-medium">{route.bestSeason}</dd>
            </div>
          </dl>

          <div class="mt-6">
            <Button href={localizedPath(locale, "/vehicles")} class="w-full">
              {t(locale, "routes_page.book_for_route")}
            </Button>
          </div>
        </div>
      </aside>
    </div>
  </article>
</Layout>
