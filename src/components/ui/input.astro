---
// src/components/ui/input.astro — SDD §6.2 (label asociado = a11y §18)
import { cn } from "@/lib/utils";

interface Props {
  id: string;
  name: string;
  type?: string;
  label: string;
  required?: boolean;
  placeholder?: string;
  value?: string | number;
  min?: number;
  max?: number;
  class?: string;
}

const {
  id,
  name,
  type = "text",
  label,
  required = false,
  placeholder,
  value,
  min,
  max,
  class: className,
} = Astro.props;
---

<div class={cn("flex flex-col gap-1", className)}>
  <label for={id} class="text-sm font-medium text-neutral-700">
    {label}
    {required && <span class="text-brand-danger" aria-hidden="true">*</span>}
  </label>
  <input
    id={id}
    name={name}
    type={type}
    required={required}
    placeholder={placeholder}
    value={value}
    min={min}
    max={max}
    class="rounded-lg border border-neutral-300 px-3 py-2 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-brand-primary"
  />
</div>
