---
// src/components/landing/cta-section.astro — Landing: CTA final
import Button from "@/components/ui/button.astro";
import { t, localizedPath, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="bg-brand-primary py-16" aria-labelledby="cta-title">
  <div class="container-page text-center">
    <h2 id="cta-title" class="font-heading text-3xl font-bold text-white">
      {t(locale, "landing.cta_title")}
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-blue-100">{t(locale, "landing.cta_subtitle")}</p>
    <div class="mt-8">
      <Button
        href={localizedPath(locale, "/vehicles")}
        size="lg"
        variant="secondary"
      >
        {t(locale, "hero.cta_fleet")}
      </Button>
    </div>
  </div>
</section>
