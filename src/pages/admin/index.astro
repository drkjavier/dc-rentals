---
// src/pages/admin/index.astro — Panel de administración (ADR-020)
// Shell HTML mínimo y autocontenido (sin header/footer de marketing):
// la island React hace todo el trabajo. noindex para no indexar en buscadores.
import "@/styles/globals.css";
import AdminPanel from "@/components/admin/admin-panel";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — DC Rentals</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    />
  </head>
  <body class="min-h-screen bg-neutral-100 font-sans text-neutral-900">
    <AdminPanel client:load />
  </body>
</html>
