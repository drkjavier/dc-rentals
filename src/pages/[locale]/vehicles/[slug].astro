---
// src/pages/[locale]/vehicles/[slug].astro — Ficha de vehículo EN (SSG, SDD §5.3)
import VehicleDetailPage from "@/components/vehicle/vehicle-detail-page.astro";
import { getVehiclesForApi, getVehicleBySlug, getSimilarVehicles } from "@/lib/content";

export async function getStaticPaths() {
  const vehicles = await getVehiclesForApi("en");
  return vehicles.map((vehicle) => ({
    params: { locale: "en", slug: vehicle.slug },
  }));
}

const { slug } = Astro.params;
const vehicle = await getVehicleBySlug(slug!, "en");
if (!vehicle) return Astro.redirect("/404");

const similar = await getSimilarVehicles(vehicle);
---

<VehicleDetailPage vehicle={vehicle} similar={similar} locale="en" />
