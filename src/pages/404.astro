---
// src/pages/404.astro — Página no encontrada (SDD §2)
import Layout from "@/components/layout/layout.astro";
import Button from "@/components/ui/button.astro";
import { t } from "@/lib/i18n";

const title = "404 — DC Rentals";
const description = "Page not found — Page introuvable";
---

<Layout locale="en" title={title} description={description}>
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-heading text-7xl font-extrabold text-brand-primary">404</p>
    <h1 class="mt-4 font-heading text-2xl font-bold text-neutral-900">
      {t("en", "common.not_found_title")} · {t("fr", "common.not_found_title")}
    </h1>
    <p class="mt-2 text-neutral-500">
      {t("en", "common.not_found_desc")} · {t("fr", "common.not_found_desc")}
    </p>
    <div class="mt-8 flex gap-4">
      <Button href="/en">{t("en", "common.back_home")}</Button>
      <Button href="/fr" variant="outline">{t("fr", "common.back_home")}</Button>
    </div>
  </div>
</Layout>
